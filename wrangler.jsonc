{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "march7th",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Vite 构建后会在生成的 Wrangler 配置中自动补齐静态资源目录。
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "images": {
    "binding": "IMAGES"
  }
}
